        <property name="text">
         <string>Auto-release GPU</string>
        </property>
        <property name="toolTip">
         <string>When enabled, ask Ollama to unload the model from VRAM as soon as each reply is complete (keep_alive=0). Prevents the model from camping in GPU memory and blocking other GPU workloads such as pTVreg deformable registration. Disable to keep the model resident between turns for faster subsequent replies.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
