        </property>
        <property name="toolTip">
         <string>When enabled, instructs reasoning models (such as DeepSeek-R1, Qwen 3.6, Gemma 4) to skip the internal reasoning/thinking phase (think: false) and answer directly. Saves 30-120 seconds of thinking time per question.</string>
        </property>
        <property name="checked">
         <bool>false</bool>
